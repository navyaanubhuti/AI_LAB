# Tic-Tac-Toe using Minimax
# Human = X
# Computer = O

board = ['1', '2', '3',
         '4', '5', '6',
         '7', '8', '9']


# Display the board
def display_board():
    print()
    print(f" {board[0]} | {board[1]} | {board[2]}")
    print("---|---|---")
    print(f" {board[3]} | {board[4]} | {board[5]}")
    print("---|---|---")
    print(f" {board[6]} | {board[7]} | {board[8]}")
    print()


# Check whether a player has won
def check_win(player):
    winning_combinations = [
        (0, 1, 2), # Row 1
        (3, 4, 5), # Row 2
        (6, 7, 8), # Row 3
        (0, 3, 6), # Column 1
        (1, 4, 7), # Column 2
        (2, 5, 8), # Column 3
        (0, 4, 8), # Main diagonal
        (2, 4, 6)  # Other diagonal
    ]

    for a, b, c in winning_combinations:
        if board[a] == player and board[b] == player and board[c] == player:
            return True

    return False


# Check whether board is full
def is_full():
    for cell in board:
        if cell not in ['X', 'O']:
            return False
    return True


# Minimax algorithm
def minimax(depth, maximizing_player):
    # Computer wins
    if check_win('O'):
        return 10 - depth

    # Human wins
    if check_win('X'):
        return depth - 10

    # Draw
    if is_full():
        return 0

    # Computer's turn - MAX
    if maximizing_player:
        best_score = -1000
        for i in range(9):
            if board[i] not in ['X', 'O']:
                # Make computer move
                board[i] = 'O'
                score = minimax(depth + 1, False)
                # Undo move
                board[i] = str(i + 1)
                best_score = max(best_score, score)
        return best_score

    # Human's turn - MIN
    else:
        best_score = 1000
        for i in range(9):
            if board[i] not in ['X', 'O']:
                # Make human move
                board[i] = 'X'
                score = minimax(depth + 1, True)
                # Undo move
                board[i] = str(i + 1)
                best_score = min(best_score, score)
        return best_score


# Find the best move for computer
def computer_move():
    best_score = -1000
    best_position = -1

    for i in range(9):
        if board[i] not in ['X', 'O']:
            # Try the move
            board[i] = 'O'
            score = minimax(0, False)
            # Undo move
            board[i] = str(i + 1)

            if score > best_score:
                best_score = score
                best_position = i

    # Make best move
    board[best_position] = 'O'
    print("Computer chose position:", best_position + 1)


# Human move
def human_move():
    while True:
        try:
            position = int(input("Enter position (1-9): "))
        except ValueError:
            print("Invalid move. Try again.")
            continue

        # Check range
        if position < 1 or position > 9:
            print("Invalid move. Try again.")
            continue

        index = position - 1

        # Check occupied position
        if board[index] in ['X', 'O']:
            print("Invalid move. Try again.")
            continue

        # Place X
        board[index] = 'X'
        break


# Main program
def main():
    print("TIC-TAC-TOE")
    print("You are X")
    print("Computer is O")
    
    # Show initial empty board configuration
    display_board()

    while True:
        # Human turn
        human_move()

        if check_win('X'):
            display_board()
            print("You win!")
            break

        if is_full():
            display_board()
            print("Draw!")
            break

        # Computer turn
        computer_move()
        display_board() # Show the updated board after computer plays

        if check_win('O'):
            print("Computer wins!")
            break

        if is_full():
            print("Draw!")
            break


# Run program
main()
